        where boarding_id = #{boardingId}
    </delete>

    <delete id="deletePetBoardingByBoardingIds" parameterType="String">
        delete from tb_pet_boarding where boarding_id in
        <foreach item="boardingId" collection="array" open="(" separator="," close=")">
