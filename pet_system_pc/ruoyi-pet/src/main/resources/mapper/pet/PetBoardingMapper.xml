    <sql id="selectPetBoardingVo">
        select boarding_id,
               user_id,
               shop_id,
               shop_name,
               name,
               species,
               breed,
               gender,
               age,
               health_info,
               neuter,
               immunity,
               insect_repellent,
               deworming_interval,
               insect_repellent_last_time,
               description,
               start_date,
               end_date,
               total_days,
               total_amount,
               special_requirement,
               emergency_contact,
               emergency_phone,
               status,
               reviewer_id,
               review_time,
               review_remark,
               check_in_time,
               check_out_time,
               payment_status,
               create_time,
               update_time,
               is_deleted,
               images
        from tb_pet_boarding
    </sql>

    <select id="selectPetBoardingList" parameterType="PetBoarding" resultMap="PetBoardingResult">
        <include refid="selectPetBoardingVo"/>
        <where>
            is_deleted = 0
            <if test="shopId != null ">and shop_id = #{shopId}</if>
            <if test="shopName != null  and shopName != ''">and shop_name like concat('%', #{shopName}, '%')</if>
            <if test="name != null  and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="species != null ">and species = #{species}</if>
            <if test="breed != null  and breed != ''">and breed = #{breed}</if>
            <if test="gender != null ">and gender = #{gender}</if>
            <if test="userId != null ">and user_id = #{userId}</if>
            <if test="neuter != null ">and neuter = #{neuter}</if>
            <if test="immunity != null ">and immunity = #{immunity}</if>
            <if test="insectRepellent != null ">and insect_repellent = #{insectRepellent}</if>
            <if test="startDate != null ">and start_date &gt;= #{startDate}</if>
            <if test="endDate != null ">and end_date &lt;= #{endDate}</if>
            <if test="status != null ">and status = #{status}</if>
            <if test="reviewTime != null ">and review_time = #{reviewTime}</if>
            <if test="reviewRemark != null  and reviewRemark != ''">and review_remark = #{reviewRemark}</if>
            <if test="paymentStatus != null ">and payment_status = #{paymentStatus}</if>
        </where>
        order by boarding_id desc
    </select>

    <select id="selectPetBoardingByBoardingId" parameterType="Long" resultMap="PetBoardingResult">
        <include refid="selectPetBoardingVo"/>
        where boarding_id = #{boardingId}
    </select>

