    <update id="updateDeletePetBoardingByBoardingIds">
        update tb_pet_boarding
        set is_deleted = 1 where boarding_id in
        <foreach item="boardingId" collection="array" open="(" separator="," close=")">
            #{boardingId}
        </foreach>
    </update>

